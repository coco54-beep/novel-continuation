{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "story_state.schema.json",
  "title": "Story State",
  "description": "故事当前状态(用于续写时的上下文对齐)",
  "type": "object",
  "required": ["state_id", "after_chapter", "characters", "facts", "conflicts",
               "foreshadowing_status", "world_facts"],
  "properties": {
    "state_id": { "type": "string", "pattern": "^state_" },
    "after_chapter": { "type": "string", "pattern": "^\\d{4}$" },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "location": { "type": "string" },
          "physical_condition": { "type": "string" },
          "mental_state": { "type": "string" },
          "current_goal": { "type": "string" },
          "known_information": { "type": "array", "items": { "type": "string" } },
          "misconceptions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "facts": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "item_owners": { "type": "array", "items": { "type": "object", "properties": { "item": { "type": "string" }, "owner": { "type": "string" } } } },
    "foreshadowing_status": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "status": { "type": "string" } } } },
    "world_facts": { "type": "array", "items": { "type": "string" } }
  }
}
