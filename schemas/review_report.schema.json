{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review_report.schema.json",
  "title": "Review Report",
  "description": "章节一致性检查报告",
  "type": "object",
  "required": ["chapter_id", "version", "overall_score", "decision", "issues"],
  "properties": {
    "chapter_id": { "type": "string", "pattern": "^\\d{4}$" },
    "version": { "type": "string" },
    "overall_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "decision": {
      "type": "string",
      "enum": ["approved", "revision_required", "major_revision_required", "rejected"]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_id", "type", "severity", "description", "suggestion", "status"],
        "properties": {
          "issue_id": { "type": "string", "pattern": "^issue_" },
          "type": {
            "type": "string",
            "enum": ["character_consistency", "knowledge_boundary", "time_space",
                     "world_rules", "plot_foreshadowing", "language_style"]
          },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "location": { "type": "string" },
          "description": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "suggestion": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "fixed", "wont_fix"] }
        }
      }
    }
  }
}
