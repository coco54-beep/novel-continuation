{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event.schema.json",
  "title": "Event",
  "description": "故事事件记录(含因果与影响)",
  "type": "object",
  "required": ["event_id", "name", "source_chapter", "cause", "result_key"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^evt_" },
    "name": { "type": "string" },
    "source_chapter": { "type": "string", "pattern": "^\\d{4}$" },
    "cause": { "type": "string" },
    "result_key": { "type": "string", "description": "事件关键结果(推动后续的关键点)" },
    "long_term_impact": { "type": "string" },
    "involved_characters": { "type": "array", "items": { "type": "string" } },
    "planned_status": {
      "type": "string",
      "enum": ["resolved", "in_progress", "open"]
    }
  }
}
