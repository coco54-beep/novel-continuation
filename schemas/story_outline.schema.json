{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "story_outline.schema.json",
  "title": "Story Outline",
  "description": "续写总纲",
  "type": "object",
  "required": ["core_theme", "ending", "remaining_main_plot", "character_arcs",
               "final_conflict", "foreshadowing_order", "turning_points"],
  "properties": {
    "core_theme": { "type": "string" },
    "ending": { "type": "string" },
    "ending_proposal_id": { "type": "string" },
    "remaining_main_plot": { "type": "array", "items": { "type": "string" } },
    "character_arcs": { "type": "array", "items": { "type": "string" } },
    "final_conflict": { "type": "string" },
    "foreshadowing_order": { "type": "array", "items": { "type": "string" } },
    "turning_points": { "type": "array", "items": { "type": "string" } },
    "volume_count": { "type": "integer", "minimum": 0 }
  }
}
