{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "relationship.schema.json",
  "title": "Relationship",
  "description": "人物关系记录",
  "type": "object",
  "required": ["relationship_id", "from_char", "to_char", "type", "status"],
  "properties": {
    "relationship_id": { "type": "string", "pattern": "^rel_" },
    "from_char": { "type": "string" },
    "to_char": { "type": "string" },
    "type": { "type": "string", "description": "如 师徒/挚友/敌对/暗恋/上下级" },
    "status": {
      "type": "string",
      "enum": ["stable", "improving", "deteriorating", "broken", "ambiguous"]
    },
    "source_chapter": { "type": "string", "pattern": "^\\d{4}$" },
    "notes": { "type": "string" }
  }
}
