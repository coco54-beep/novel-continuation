{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "foreshadowing.schema.json",
  "title": "Foreshadowing",
  "description": "伏笔记录",
  "type": "object",
  "required": ["foreshadowing_id", "name", "status", "first_chapter", "importance"],
  "properties": {
    "foreshadowing_id": { "type": "string", "pattern": "^foreshadow_" },
    "name": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["planted", "reinforced", "partially_revealed", "misdirected",
               "resolved", "abandoned"]
    },
    "first_chapter": { "type": "string", "pattern": "^\\d{4}$" },
    "related_characters": { "type": "array", "items": { "type": "string" } },
    "possible_explanations": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "importance": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "recommended_resolution_range": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\d{4}$" },
      "minItems": 2,
      "maxItems": 2
    }
  }
}
